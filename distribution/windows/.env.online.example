# Dynamics 365 Online / Dataverse. Copy to .env and fill in your app registration.
AUTH_TYPE=online
ORG_URL=https://YOUR_ORGANIZATION.crm.dynamics.com
API_VERSION=v9.2
TENANT_ID=YOUR_TENANT_ID
CLIENT_ID=YOUR_CLIENT_ID
CLIENT_SECRET="YOUR_CLIENT_SECRET"
REQUEST_TIMEOUT_MS=30000
MAX_READ_RETRIES=2
CACHE_TTL=7200
