# On-premises CRM / AD-NTLM. Replace every YOUR_* placeholder.
# Use the organization root URL, including its organization path where applicable.
# Quote passwords, especially if they contain # or spaces.
AUTH_TYPE=op_ad
ORG_URL=https://crm.example.com/YOUR_ORGANIZATION
API_VERSION=v9.1
AD_DOMAIN=YOUR_DOMAIN
AD_USERNAME=YOUR_USERNAME
AD_PASSWORD="YOUR_PASSWORD"
REQUEST_TIMEOUT_MS=30000
MAX_READ_RETRIES=2
CACHE_TTL=7200
