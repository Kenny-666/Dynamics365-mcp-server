# On-premises CRM / IFD-ADFS password grant. Copy to .env and fill in your settings.
AUTH_TYPE=op_ifd
ORG_URL=https://YOUR_ORGANIZATION.example.com
API_VERSION=v9.1
IFD_ADFS_URL=https://adfs.example.com
IFD_CLIENT_ID=YOUR_ADFS_CLIENT_ID
IFD_USERNAME=YOUR_USERNAME
IFD_PASSWORD="YOUR_PASSWORD"
# IFD_CLIENT_SECRET="YOUR_OPTIONAL_CLIENT_SECRET"
REQUEST_TIMEOUT_MS=30000
MAX_READ_RETRIES=2
CACHE_TTL=7200
